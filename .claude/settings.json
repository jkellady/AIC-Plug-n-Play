{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(./.venv/Scripts/python.exe -m pytest *)",
      "Bash(./.venv/Scripts/python.exe -m src.rules check*)",
      "Bash(./.venv/Scripts/python.exe run.py *)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch*)",
      "Bash(git stash *)",
      "Edit(/src/**)",
      "Edit(/tests/**)"
    ],
    "deny": [
      "Edit(/01_DROP_FOLDER/**)",
      "Edit(/02_RAW_ARCHIVE/**)",
      "Edit(/04_REFERENCE_SOURCES/**)",
      "Edit(/03_MASTER_DATA/rules.toml)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(scp *)",
      "Bash(ssh *)",
      "Bash(rm -rf *)",
      "Bash(del *)",
      "Bash(pip install *)",
      "Bash(pip uninstall *)",
      "Bash(./.venv/Scripts/pip *)",
      "Bash(python -m pip *)",
      "Bash(net *)",
      "Bash(netsh *)",
      "Bash(certutil *)",
      "Bash(bitsadmin *)",
      "Bash(Start-Process *)",
      "PowerShell(git push *)",
      "PowerShell(git remote *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Start-Process *)",
      "PowerShell(pip install *)",
      "PowerShell(pip uninstall *)",
      "PowerShell(New-NetFirewallRule *)",
      "PowerShell(Set-NetFirewallRule *)",
      "PowerShell(Send-MailMessage *)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
